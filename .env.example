# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/matchme

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Cookie
COOKIE_SECRET=your_cookie_secret_change_in_production

# Backblaze B2  (endpoint/region/public URL are auto-detected at startup)
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_application_key
B2_BUCKET_NAME=your_bucket_name
B2_BUCKET_ID=your_b2_bucket_id

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@matchme.ng

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin Seed (used only for initial seed)
ADMIN_EMAIL=admin@matchme.ng
ADMIN_PASSWORD=Admin@1234!

# Bank Details for Payment
BANK_NAME=First Bank of Nigeria
BANK_ACCOUNT_NAME=MatchMe Services Ltd
BANK_ACCOUNT_NUMBER=3012345678
